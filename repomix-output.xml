<file path="backend/src/index.ts">
import express from 'express';
import dotenv from 'dotenv';
import cors from 'cors';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import { sql, eq, like, or } from 'drizzle-orm';
import { db } from './core/database';
import { 
  users, 
  sectors, 
  roles, 
  clientes, 
  clientCustomFields, 
  clientCustomValues 
} from './core/database/schema';
import { authenticateToken, AuthenticatedRequest } from './core/auth/auth.middleware';
import { checkPermission } from './core/permissions/permission.middleware';

dotenv.config();

const app = express();
const PORT = process.env.PORT || 3000;

app.use(cors());
app.use(express.json());

// --- HEALTH CHECK ---
app.get('/health', (req, res) => {
  try {
    db.run(sql`SELECT 1`);
    res.json({
      status: 'OK',
      message: 'Plataforma HB Backend rodando e conectado ao SQLite!',
      timestamp: new Date().toISOString()
    });
  } catch (error: any) {
    res.status(500).json({ status: 'ERROR', message: 'Falha na conexão com o banco', error: error?.message || error });
  }
});

// --- AUTENTICAÇÃO ---

// 1. Rota de Login
app.post('/api/auth/login', async (req, res) => {
  const { email, password } = req.body;

  if (!email || !password) {
    return res.status(400).json({ error: 'Email e senha são obrigatórios.' });
  }

  try {
    const userList = await db.select().from(users).where(eq(users.email, email)).limit(1);
    const user = userList[0];

    if (!user) {
      return res.status(401).json({ error: 'Credenciais inválidas.' });
    }

    const passwordMatch = await bcrypt.compare(password, user.passwordHash);
    if (!passwordMatch) {
      return res.status(401).json({ error: 'Credenciais inválidas.' });
    }

    const token = jwt.sign(
      {
        id: user.id,
        name: user.name,
        email: user.email,
        sectorId: user.sectorId,
        roleId: user.roleId,
      },
      process.env.JWT_SECRET || 'super_secreto_alterar_em_producao',
      { expiresIn: '8h' }
    );

    return res.json({
      token,
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        sectorId: user.sectorId,
        roleId: user.roleId,
      }
    });
  } catch (error: any) {
    return res.status(500).json({ error: 'Erro no servidor durante o login.', details: error?.message });
  }
});

// 2. Rota ME (Usuário logado)
app.get('/api/auth/me', authenticateToken, (req: AuthenticatedRequest, res) => {
  res.json({ user: req.user });
});

// --- USUÁRIOS ---
app.get('/api/users', authenticateToken, async (req, res) => {
  try {
    const allUsers = await db.select({
      id: users.id,
      name: users.name,
      email: users.email,
      active: users.active,
      sectorId: users.sectorId,
      roleId: users.roleId,
    }).from(users);

    res.json(allUsers);
  } catch (error: any) {
    res.status(500).json({ error: 'Erro ao buscar usuários.' });
  }
});

// --- MÓDULO DE CLIENTES ---

// 1. Cadastrar Cliente
app.post('/api/clientes', authenticateToken, async (req, res) => {
  try {
    const { 
      nome, cpf, rg, dataNascimento, nomeMae, genero, nacionalidade, 
      estadoCivil, profissao, telefone, origem, cep, endereco, 
      bairro, cidade, estado, nomeRepresentante, cpfRepresentante, 
      senhaGov, nis 
    } = req.body;

    // Validação dos campos obrigatórios
    if (!nome || !cpf) {
      return res.status(400).json({ error: 'Nome e CPF são obrigatórios.' });
    }

    const novoCliente = await db.insert(clientes).values({
      id: crypto.randomUUID(),
      nome,
      cpf,
      rg,
      dataNascimento,
      nomeMae,
      genero,
      nacionalidade,
      estadoCivil,
      profissao,
      telefone,
      origem,
      cep,
      endereco,
      bairro,
      cidade,
      estado,
      nomeRepresentante,
      cpfRepresentante,
      senhaGov,
      nis,
      criadoEm: new Date().toISOString(),
      atualizadoEm: new Date().toISOString()
    }).returning();

    return res.status(201).json(novoCliente[0]);

  } catch (error: any) {
    console.error('Erro ao cadastrar cliente:', error);
    
    // Tratamento específico de erro do SQLite para CPF duplicado
    if (error.message?.includes('UNIQUE constraint failed') || error.code === 'SQLITE_CONSTRAINT_UNIQUE') {
      return res.status(400).json({ error: 'Já existe um cliente cadastrado com este CPF.' });
    }

    return res.status(500).json({ 
      error: 'Erro interno ao salvar cliente no banco de dados.', 
      details: error.message 
    });
  }
});

// 2. Listar Clientes
app.get('/api/clientes', authenticateToken, checkPermission('clientes', 'view'), async (req, res) => {
  try {
    const search = req.query.search ? String(req.query.search) : '';

    if (!search) {
      const todosClientes = await db.select().from(clientes);
      return res.json(todosClientes);
    }

    const termoBusca = `%${search}%`;

    const resultados = await db.select().from(clientes).where(
      or(
        like(clientes.nome, termoBusca),
        like(clientes.cpf, termoBusca),
        like(clientes.rg, termoBusca),
        like(clientes.nomeMae, termoBusca),
        like(clientes.origem, termoBusca),
        like(clientes.dataNascimento, termoBusca),
        like(clientes.estadoCivil, termoBusca),
        like(clientes.profissao, termoBusca),
        like(clientes.genero, termoBusca),
        like(clientes.nacionalidade, termoBusca),
        like(clientes.telefone, termoBusca),
        like(clientes.cep, termoBusca),
        like(clientes.estado, termoBusca),
        like(clientes.cidade, termoBusca),
        like(clientes.endereco, termoBusca),
        like(clientes.bairro, termoBusca),
        like(clientes.nomeRepresentante, termoBusca),
        like(clientes.cpfRepresentante, termoBusca),
        like(clientes.senhaGov, termoBusca),
        like(clientes.nis, termoBusca)
      )
    );

    return res.json(resultados);
  } catch (erro: any) {
    console.error('Erro ao buscar clientes:', erro);
    return res.status(500).json({ error: 'Erro ao buscar clientes.', details: erro?.message });
  }
});

// 3. Detalhes do Cliente
app.get('/api/clientes/:id', authenticateToken, checkPermission('clientes', 'view'), async (req, res) => {
  try {
    const id = String(req.params.id);
    const listaClientes = await db.select().from(clientes).where(eq(clientes.id, id)).limit(1);

    if (!listaClientes[0]) {
      return res.status(404).json({ error: 'Cliente não encontrado.' });
    }

    const valoresCustomizados = await db
      .select({
        fieldId: clientCustomValues.fieldId,
        label: clientCustomFields.label,
        fieldName: clientCustomFields.fieldName,
        value: clientCustomValues.value,
      })
      .from(clientCustomValues)
      .innerJoin(clientCustomFields, eq(clientCustomValues.fieldId, clientCustomFields.id))
      .where(eq(clientCustomValues.clientId, id));

    res.json({
      ...listaClientes[0],
      camposCustomizados: valoresCustomizados,
    });
  } catch (error: any) {
    res.status(500).json({ error: 'Erro ao buscar detalhes do cliente.', details: error?.message });
  }
});

app.listen(PORT, () => {
  console.log(`🚀 Servidor rodando localmente em http://localhost:${PORT}`);
});
</file>

